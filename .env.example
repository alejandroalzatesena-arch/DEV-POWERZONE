# ============================================================
# Power Zone Backend - Variables de entorno
# Copia este archivo como `.env` y ajusta los valores.
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=Power Zone API
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
BCRYPT_ROUNDS=10

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=powerzone
# Solo para desarrollo; usa migraciones en producción.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=cambia-este-secreto-access
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Stripe (opcional; sin clave se usa modo mock) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Servicio de IA (FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-ai-key

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100