# Copia a .env y ajusta los valores para tu entorno local.
PORT=3000
CORS_ORIGINS=http://localhost:4200
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=powerzone
JWT_ACCESS_SECRET=cambia-este-secreto-access
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-ai-key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo para un entorno de demostración; nunca en producción.
SEED_DEMO=false
THROTTLE_LIMIT=100
THROTTLE_WINDOW_SECONDS=60
